{
  "manifest_version": 3,
  "name": "AutoFill",
  "version": "1.5.0",
  "description": "מילוי אוטומטי מהיר לכל שדה באינטרנט",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/storage.js",
        "content/selector.js",
        "content/fill.js",
        "content/icons.js",
        "content/dropdown.js",
        "content/config-panel.js",
        "content/snippet.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "AutoFill · ניהול",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
